# Copier ce fichier en .env pour modifier un réglage facultatif (le fichier .env est ignoré par git).
# Les variables déjà définies dans l'environnement sont prioritaires sur ce fichier.
#
# TRACE s'exécute entièrement en local : les agents sont joués par un modèle servi par Ollama sur cet ordinateur
# (voir docs/local_runtime.md). Aucune clé, aucune API externe. Aucune variable n'est obligatoire.

# --- Runtime local (Ollama) --------------------------------------------------------------------
# Modèle Ollama utilisé par tous les agents (installation : ollama pull qwen2.5:7b).
# TRACE_LOCAL_MODEL=qwen2.5:7b
# Modèle du SEUL Episode Grounding Checker (diagnostic de l'étape 4, rapport seulement), pour comparer des modèles sur
# les mêmes épisodes ; le reste du pipeline garde TRACE_LOCAL_MODEL. Par défaut : TRACE_LOCAL_MODEL.
# TRACE_GROUNDING_MODEL=
# Adresse d'Ollama : boucle locale uniquement (localhost, 127.0.0.1, ::1) ; toute autre adresse est refusée.
# TRACE_OLLAMA_URL=http://localhost:11434
# Fenêtre de contexte MAXIMALE : chaque appel reçoit la plus petite fenêtre qui contient sa requête et sa réponse ;
# une requête plus longue est refusée (jamais tronquée).
# TRACE_OLLAMA_NUM_CTX=32768
# Durée pendant laquelle Ollama garde le modèle chargé entre deux appels.
# TRACE_OLLAMA_KEEP_ALIVE=30m
# Délai maximal d'une génération, en secondes.
# TRACE_OLLAMA_TIMEOUT=1800
# Nouvelles tentatives LOCALES après un JSON invalide, hors schéma ou tronqué, de 0 à 5.
# TRACE_LOCAL_MAX_CORRECTIONS=2
# Nouvelles tentatives LOCALES après une anomalie bloquante du validateur méthodologique, de 0 à 5
# (chaque tentative régénère toute la réponse ; 2 = ancien comportement).
# TRACE_LOCAL_MAX_METHOD_CORRECTIONS=1
# Température (0 : reproductibilité).
# TRACE_LOCAL_TEMPERATURE=0
# Appels simultanés au modèle local (1 à 4).
# TRACE_LOCAL_CONCURRENCY=1

# --- Lecture des entretiens longs (étape 3) -----------------------------------------------------
# Interaction Signal Reader : taille cible d'un bloc, en tokens estimés (défaut 5000, de 500 à 30000).
# TRACE_INTERACTION_CHUNK_TOKENS=5000
# Practice Extractor : taille cible d'un bloc, en tokens estimés (défaut 4000, de 500 à 30000).
# TRACE_PRACTICE_CHUNK_TOKENS=4000
