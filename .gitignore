# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Données de recherche et sorties des runs (jamais versionnées)
data/inputs/**
data/outputs/**
# Cache des analyses IA (contient des extraits d'entretiens)
data/cache/**
data/problematique.txt
!data/inputs/.gitkeep
!data/outputs/.gitkeep

# Journaux (peuvent contenir des noms de fichiers ou extraits d'entretiens)
logs/**
!logs/.gitkeep
*.log

# Fichiers temporaires
tmp/
*.tmp
*.bak
*.swp
*~
~$*
.~lock.*#

# Système / éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/

# Résultats des benchmarks locaux (mesures propres à chaque machine)
benchmarks/results/
